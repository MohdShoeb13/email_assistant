# Copy to .env and fill in. The app runs fully without either key when FAKE_LLM=1.

# Offline mode: deterministic canned responses, no network, no cost.
# Set to 0 (or remove) once you have a real key below.
FAKE_LLM=1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which profile in backend/config/mcp.yaml to route with: quality | cost
ROUTING_PROFILE=quality
